# Neo4j (VAULT)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=eddapassword

# Ollama (for SCRIBE when not using mock)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mixtral:8x7b-instruct-v0.1-q4_K_M

# Mock LLM - set to true to run SCRIBE without GPU/Ollama
USE_MOCK_LLM=true
MOCK_MODEL_PATH=

# Git (for WARDEN and SCRIBE repo access)
GIT_BASE_URL=https://git.internal
GIT_USERNAME=edda-service
GIT_TOKEN=

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:3000
# Optional: require X-API-Key header (extension point for SAML/LDAP + RBAC)
EDDA_API_KEY=

# VAULT version retention (versions per system)
VAULT_VERSION_RETENTION=10

# Frontend (READER)
REACT_APP_API_URL=http://localhost:8000

# WARDEN (drift detection)
DRIFT_CHECK_SCHEDULE=0 2 * * *
DRIFT_ALERT_MIN_SEVERITY=high
DRIFT_AUTO_UPDATE=false
DRIFT_AUTO_UPDATE_MAX=3
WARDEN_RUN_ONCE=false
SLACK_WEBHOOK_URL=
